# --- Canvas (ingest course modules — Study Assistant) ---
# Token: https://canvas.anu.edu.au/profile/settings → "+ New Access Token"
CANVAS_BASE_URL=https://canvas.anu.edu.au
CANVAS_TOKEN=

# --- OpenAI (embeddings + grounded chat + quiz generation — server-only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- OpenRouter (optional legacy `/api/chat` streaming — server-only) ---
OPENROUTER_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (admin upload + optional DB — server-only for service role) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
