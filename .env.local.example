# --- Canvas (ANU) ---
# Generate at https://canvas.anu.edu.au/profile/settings -> "+ New Access Token"
# Server-only. Never expose this to the browser.
CANVAS_BASE_URL=https://canvas.anu.edu.au
CANVAS_TOKEN=your-canvas-personal-access-token

# --- OpenAI ---
# Server-only.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# --- Supabase (optional, not used in MVP) ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
